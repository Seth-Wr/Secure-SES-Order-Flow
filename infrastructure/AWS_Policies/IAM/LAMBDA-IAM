{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ProductionEmailSending",
            "Effect": "Allow",
            "Action": [
                "ses:SendEmail",
                "ses:SendRawEmail"
            ],
            "Resource": [
                "arn:aws:ses:<REGION>:<AWS_ACCOUNT_ID>:identity/<YOUR_DOMAIN>"
            ],
            "Condition": {
                "StringLike": {
                    "ses:FromAddress": "*<YOUR_DOMAIN>"
                }
            }
        },
        {
            "Sid": "S3LoggingAccess",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::<YOUR_LOG_BUCKET>",
                "arn:aws:s3:::<YOUR_LOG_BUCKET>/*"
            ]
        }
    ]
}
