    "viz_jfsbYa56": {
      "dataSources": {
        "primary": "ds_AnvHSkvL"
      },
      "options": {
        "collapseThreshold": 0.01,
        "labelDisplay": "off",
        "seriesColorsByField": {
          "200": "#118822",
          "400": "#D93A3A",
          "500": "#F27813"
        }
      },
      "title": "HTTP Status Codes",
      "type": "splunk.pie"
    }
  },
  "dataSources": {
    "ds_AnvHSkvL": {
      "name": "HTTP Status Codes - Pie chart search",
      "options": {
        "query": "index=\"main\" source=\"/opt/splunk/s3_data/*\" | stats count by status",
        "queryParameters": {
          "earliest": "-24h@h",
          "latest": "now",
          "sampleRatio": 1
        }
      },
      "type": "ds.search"
    },
    "ds_DYglnsLR": {
      "name": "Fired_Honeypot_Alerts",
      "options": {
        "query": "index=_audit action=alert_fired ss_name=\"Honeypot Bot Trap Triggered\"\n| eval _time=strftime(trigger_time, \"%Y-%m-%d %H:%M:%S\")\n| rename ss_name as \"Security Event Triggered\"\n| table _time \"Security Event Triggered\"\n"
      },
      "type": "ds.search"
    },
    "ds_ke7YTSMp": {
      "name": "Geographic Traffic Origin by City search",
      "options": {
        "query": "index=\"main\" source=\"/opt/splunk/s3_data/*\" | iplocation ip | geostats count by City",
        "queryParameters": {
          "earliest": "-24h@h",
          "latest": "now",
          "sampleRatio": 1
        }
      },
      "type": "ds.search"
    }
  },
